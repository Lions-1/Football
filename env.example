# Rename this file to .env and fill in the values for local dev
# On Vercel, set these in Project Settings → Environment Variables

# PostgreSQL connection string from Neon (or Supabase)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret key for signing admin session tokens (make it long and random)
ADMIN_SECRET="change-this-to-a-long-random-string-in-production"
